<!-- LEFT: INPUTS -->
<section class="card">
  <div class="card-title">
    <span>Plan inputs</span>
    <span class="badge">Monte Carlo (accumulation + decumulation)</span>
  </div>

  <div class="inputs-grid">
    <label>
      <span class="title"><strong>Current age</strong></span>
      <input id="currentAge" type="number" value="30" min="18" max="80" />
    </label>
    <label>
      <span class="title"><strong>Current retirement savings</strong><small>(2025 $)</small></span>
      <input id="currentSavings" type="number" value="150000" step="10000" />
    </label>
    <label>
      <span class="title"><strong>Household income</strong><small>(2025 $ / yr)</small></span>
      <input id="income" type="number" value="180000" step="1000" />
    </label>
    <label>
      <span class="title"><strong>Annual savings rate</strong><small>% of income</small></span>
      <input id="savingsRate" type="number" value="20" step="0.5" />
    </label>
    <label>
      <span class="title"><strong>Income growth</strong><small>% real / yr</small></span>
      <input id="incomeGrowth" type="number" value="1.5" step="0.1" />
    </label>
    <label>
      <span class="title">
        <strong>Income needed in retirement</strong>
        <small><span id="retSpendPreview">–</span></small>
      </span>
      <input id="replaceRate" type="number" value="70" step="0.5" />
    </label>
    <label>
      <span class="title"><strong>Planning horizon</strong><small>max age</small></span>
      <input id="maxAge" type="number" value="110" min="80" max="120" />
    </label>
    <label>
      <span class="title"><strong>Target success probability</strong></span>
      <input id="targetSuccess" type="number" value="0.95" min="0.5" max="0.99" step="0.01" />
    </label>
    <label>
      <span class="title"><strong>Simulations</strong><small><span id="simsLabel">40000</span> paths</small></span>
      <input id="sims" type="range" min="1000" max="100000" value="40000" step="1000" />
    </label>
    <label>
      <span class="title"><strong>Max retirement age to consider</strong></span>
      <input id="maxRetAge" type="number" value="65" min="40" max="90" />
    </label>
  </div>

  <div class="advanced-toggle" id="advancedToggle">
    Advanced portfolio, return & health assumptions <span id="advancedChevron">▾</span>
  </div>
  <div class="advanced-panel" id="advancedPanel">
    <div class="inputs-grid">
      <label>
        <span class="title"><strong>Return assumption preset</strong></span>
        <select id="returnPreset">
          <option value="conservative">Conservative</option>
          <option value="base" selected>Base / Recommended</option>
          <option value="aggressive">Aggressive</option>
          <option value="custom">Custom</option>
        </select>
      </label>
      <label>
        <span class="title"><strong>Pre-retirement equity weight</strong><small>0–1</small></span>
        <input id="eqPre" type="number" value="0.85" min="0" max="1" step="0.05" />
      </label>
      <label>
        <span class="title"><strong>Post-retirement equity weight</strong><small>0–1</small></span>
        <input id="eqPost" type="number" value="0.6" min="0" max="1" step="0.05" />
      </label>
      <label>
        <span class="title"><strong>Expected stock return</strong><small>% real / yr</small></span>
        <input id="stockReturn" type="number" value="5.5" min="-10" max="20" step="0.1" disabled />
      </label>
      <label>
        <span class="title"><strong>Expected bond return</strong><small>% real / yr</small></span>
        <input id="bondReturn" type="number" value="1.0" min="-10" max="10" step="0.1" disabled />
      </label>
      <label>
        <span class="title"><strong>Derived pre-ret return</strong><small>% real / yr</small></span>
        <input id="expPre" type="number" value="4.8" step="0.1" readonly />
      </label>
      <label>
        <span class="title"><strong>Derived post-ret return</strong><small>% real / yr</small></span>
        <input id="expPost" type="number" value="3.7" step="0.1" readonly />
      </label>
      <label>
        <span class="title"><strong>Max catastrophic health shocks</strong><small>0 = none</small></span>
        <input id="healthShocks" type="number" value="3" min="0" max="15" step="1" />
      </label>
      <label>
        <span class="title"><strong>LTC duration</strong><small>years (0 = none)</small></span>
        <input id="ltcYears" type="number" value="3" min="0" max="10" step="1" />
      </label>
    </div>
    <p class="hint" id="returnAssumptionHint">
      Choose a forward-looking real return scenario. These are not predictions; they are planning assumptions.
      Custom values should represent forward-looking real stock and bond returns. Do not enter recent portfolio CAGR unless you are intentionally modeling an upside case.
    </p>
    <p class="hint">
      Health shocks use age-varying probabilities with lognormal costs. LTC is an optional multi-year episode (75–95) with about 30% lifetime probability.
      Both health shocks and LTC costs grow faster than general spending in real terms.
    </p>
  </div>

  <div class="btn-row">
    <button class="primary" id="runBtn">Run simulation</button>
    <div class="status-text" id="statusText">
      <span class="dot" style="display:none;"></span>
      <span>Ready</span>
    </div>
  </div>
</section>
